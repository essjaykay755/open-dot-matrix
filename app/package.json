{
  "name": "open-dot-matrix",
  "productName": "Open Dot Matrix",
  "version": "0.1.2",
  "description": "Open-source desktop studio for iDotMatrix 64x64 LED panels",
  "main": "./out/main/index.js",
  "author": "Open Dot Matrix",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "gifenc": "^1.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
